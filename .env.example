# Copy this file to .env.local and fill in the real values.
# Never commit .env.local to git.

# The address of your MongoDB Atlas database.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority"

# A long random secret. Used for the login cookie.
JWT_SECRET="change-this-to-a-long-random-string"

# The web address of the app. No slash at the end.
# On your own computer use http://localhost:3000
# On Vercel you can only fill this in AFTER the first deploy, because Vercel
# decides the address. If you leave it empty, the app works the address out
# from your browser. Fill it in so the join link is always the right one.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google sheet (optional). Leave these empty and the app works as before,
# just without the live sheet. See the README for how to get them.
# ---------------------------------------------------------------------------

# The long code in the middle of your sheet's web address.
GOOGLE_SHEET_ID=""

# The email address of the robot Google account, from the key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL="name@your-project.iam.gserviceaccount.com"

# The private key from the same key file. Keep the quotes.
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nLOTS-OF-LETTERS\n-----END PRIVATE KEY-----\n"

# The name of the tab inside the sheet. Leave empty to use "Attendees".
GOOGLE_SHEET_TAB="Attendees"
