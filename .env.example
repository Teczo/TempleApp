# Copy this file to .env.local and fill in the real values.
# Never commit .env.local to git.

# The address of your MongoDB Atlas database.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority"

# A long random secret. Used for login in a later phase.
JWT_SECRET="change-this-to-a-long-random-string"

# The web address of the app. No slash at the end.
# On your own computer use http://localhost:3000
# On Vercel you can only fill this in AFTER the first deploy, because Vercel
# decides the address. Nothing uses it until Phase 5, so it is safe to leave.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
